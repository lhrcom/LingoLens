{
  "manifest_version": 3,
  "name": "LingoLens",
  "version": "1.3.6",
  "minimum_chrome_version": "116",
  "description": "Translate web pages and selections, create bilingual video captions, and build YouTube learning resources.",
  "permissions": [
    "activeTab",
    "offscreen",
    "sidePanel",
    "storage",
    "scripting",
    "tabCapture",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*",
    "https://api.deepgram.com/*"
  ],
  "action": {
    "default_title": "Open LingoLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-translation-core.js", "page-translation-content.js"],
      "css": ["page-translation.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
